        { "type": "contains", "path": "summary", "value": "drafts responses" },
        { "type": "equals", "path": "goalCount", "value": 3 },
        { "type": "equals", "path": "phaseCount", "value": 5 },
        {
          "type": "equals",
          "path": "groups",
          "value": ["Commercial", "Technical", "Operational", "Compliance"]
        },
        {
          "type": "equals",
          "path": "firstOut",
          "value": "Direct replies to HCPs or autonomous medical advice."
        },
        { "type": "equals", "path": "effortMin", "value": 10 },
        { "type": "equals", "path": "effortMax", "value": 19 },
        {
          "type": "equals",
          "path": "driverIds",
          "value": ["data-readiness", "compliance", "human-review"]
        },
        { "type": "equals", "path": "matchesModel", "value": true },
        { "type": "equals", "path": "rangesValid", "value": true }
      ]
    },
    {
      "description": "Sterling FinTech brief returns the recorded scope and a 12 to 23 person-week band",
      "vars": { "task": "forge", "sampleId": "04-fintech-kpi-narrative" },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "fixture" },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "syntheticBanner", "value": true },
        { "type": "equals", "path": "customer", "value": "Sterling FinTech Ltd" },
        { "type": "equals", "path": "sector", "value": "FinTech" },
        { "type": "equals", "path": "title", "value": "QBR narratives, grounded in data" },
        { "type": "contains", "path": "summary", "value": "verified usage metrics" },
        { "type": "contains", "path": "notice", "value": "curated scope fixture" },
        { "type": "equals", "path": "goalCount", "value": 3 },
        { "type": "equals", "path": "phaseCount", "value": 5 },
        {
          "type": "equals",
          "path": "phaseNames",
          "value": ["Discover", "Design", "Build", "Pilot", "Handover"]
        },
        {
          "type": "equals",
          "path": "groups",
          "value": ["Commercial", "Technical", "Operational", "Compliance"]
        },
        { "type": "gte", "path": "assumptionCount", "value": 3 },
        { "type": "gte", "path": "riskCount", "value": 3 },
        { "type": "gte", "path": "metricCount", "value": 3 },
        {
          "type": "equals",
          "path": "firstOut",
          "value": "Autonomous customer delivery or CRM write-back."
        },
        { "type": "equals", "path": "effortSize", "value": "Medium" },
        { "type": "equals", "path": "effortMin", "value": 12 },
        { "type": "equals", "path": "effortMax", "value": 23 },
        {
          "type": "equals",
          "path": "driverIds",
          "value": [
            "integrations",
            "data-readiness",
            "sso",
            "residency",
            "human-review"
          ]
        },
        { "type": "equals", "path": "matchesModel", "value": true },
        { "type": "equals", "path": "rangesValid", "value": true }
      ]
    },
    {
      "description": "Extra whitespace still matches the Sterling brief to its recorded scope",
      "vars": {
        "task": "forge",
        "sampleId": "04-fintech-kpi-narrative",
        "collapseWhitespace": true
      },
      "assert": [
        { "type": "equals", "path": "source", "value": "fixture" },
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "customer", "value": "Sterling FinTech Ltd" },
        { "type": "equals", "path": "title", "value": "QBR narratives, grounded in data" },
        { "type": "equals", "path": "effortMin", "value": 12 },
        { "type": "equals", "path": "effortMax", "value": 23 },
        { "type": "equals", "path": "syntheticBanner", "value": true }
      ]
    },
    {
      "description": "A rewritten brief stays heuristic even when a sample id is supplied",
      "vars": {
        "task": "forge",
        "sampleId": "04-fintech-kpi-narrative",
        "brief": "We need a short internal summary of weekly warehouse notes for one team only."
      },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "heuristic" },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "customer", "value": "Fictional demo customer" },
        { "type": "equals", "path": "title", "value": "A focused pilot for a clearer next step" },
        { "type": "not-contains", "path": "title", "value": "QBR" },
        { "type": "not-contains", "path": "customer", "value": "Sterling" },
        { "type": "contains", "path": "notice", "value": "heuristic draft" },
        { "type": "equals", "path": "effortMin", "value": 8 },
        { "type": "equals", "path": "effortMax", "value": 15 }
      ]
    },
    {
      "description": "Empty, short, whitespace-only and unknown-sector briefs are rejected",
      "vars": { "task": "parse-edges" },
      "assert": [
        { "type": "equals", "path": "rejected", "value": true },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        {
          "type": "equals",
          "path": "emptyMessage",
          "value": "Add at least 20 characters to give us something to scope."
        },
        {
          "type": "equals",
          "path": "shortMessage",
          "value": "Add at least 20 characters to give us something to scope."
        },
        {
          "type": "equals",
          "path": "blankMessage",
          "value": "Add at least 20 characters to give us something to scope."
        },
        {
          "type": "equals",
          "path": "badSectorMessage",
          "value": "Invalid option: expected one of \"Logistics\"|\"Bioscience\"|\"Pharmaceuticals\"|\"Finance\"|\"FinTech\""
        }
      ]
    },
    {
      "description": "A brief longer than 12000 characters is rejected",
      "vars": { "task": "parse", "briefLength": 12001 },
      "assert": [
        { "type": "equals", "path": "rejected", "value": true },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        {
          "type": "equals",
          "path": "overlongMessage",
          "value": "Too big: expected string to have <=12000 characters"
        }
      ]
    },
    {
      "description": "A junk brief still returns a bounded heuristic scope for a fictional customer",
      "vars": {
        "task": "forge",
        "brief": "???? !!!! $$$$ #### %%%% ~~~~ ^^^^"
      },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "heuristic" },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "customer", "value": "Fictional demo customer" },
        { "type": "equals", "path": "sector", "value": "Finance" },
        { "type": "equals", "path": "title", "value": "A focused pilot for a clearer next step" },
        { "type": "contains", "path": "summary", "value": "$$$$ #### %%%%" },
        { "type": "contains", "path": "notice", "value": "heuristic draft" },
        { "type": "equals", "path": "goalCount", "value": 3 },
        { "type": "equals", "path": "phaseCount", "value": 5 },
        {
          "type": "equals",
          "path": "phaseNames",
          "value": ["Discover", "Design", "Build", "Pilot", "Handover"]
        },
        {
          "type": "equals",
          "path": "groups",
          "value": ["Commercial", "Technical", "Operational", "Compliance"]
        },
        { "type": "gte", "path": "outOfScopeCount", "value": 1 },
        { "type": "gte", "path": "assumptionCount", "value": 3 },
        { "type": "gte", "path": "riskCount", "value": 3 },
        { "type": "gte", "path": "metricCount", "value": 3 },
        { "type": "equals", "path": "effortSize", "value": "Medium" },
        { "type": "equals", "path": "effortMin", "value": 8 },
        { "type": "equals", "path": "effortMax", "value": 15 },
        {
          "type": "equals",
          "path": "driverIds",
          "value": ["data-readiness", "human-review"]
        },
        { "type": "equals", "path": "rangesValid", "value": true },
        { "type": "equals", "path": "matchesModel", "value": true }
      ]
    },
    {
      "description": "Integration, identity, compliance and residency words add effort drivers",
      "vars": {
        "task": "forge",
        "brief": "The pilot needs an API integration with current systems and the CRM, SSO sign-on, a compliance audit, and data residency with regional retention."
      },
      "assert": [
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "heuristic" },
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "customer", "value": "Fictional demo customer" },
        { "type": "equals", "path": "effortSize", "value": "Medium" },
        { "type": "equals", "path": "effortMin", "value": 14 },
        { "type": "equals", "path": "effortMax", "value": 27 },
        {
          "type": "equals",
          "path": "driverIds",
          "value": [
            "data-readiness",
            "human-review",
            "integrations",
            "sso",
            "compliance",
            "residency"
          ]
        },
        { "type": "contains", "path": "summary", "value": "API integration" },
        { "type": "contains", "path": "summary", "value": "regional reten" },
        { "type": "equals", "path": "matchesModel", "value": true }
      ]
    },
    {
      "description": "A plain brief keeps the default drivers and the Finance sector",
      "vars": {
        "task": "forge",
        "brief": "Prepare one bounded internal workflow with a named reviewer and a written next step."
      },
      "assert": [
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "heuristic" },
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "sector", "value": "Finance" },
        { "type": "equals", "path": "customer", "value": "Fictional demo customer" },
        { "type": "equals", "path": "effortMin", "value": 8 },
        { "type": "equals", "path": "effortMax", "value": 15 },
        {
          "type": "equals",
          "path": "driverIds",
          "value": ["data-readiness", "human-review"]
        },
        {
          "type": "contains",
          "path": "summary",
          "value": "Prepare one bounded internal workflow"
        }
      ]
    },
    {
      "description": "A supplied sector is kept on a free-text brief",
      "vars": {
        "task": "forge",
        "sector": "Bioscience",
        "brief": "Prepare one bounded internal workflow with a named reviewer and a written next step."
      },
      "assert": [
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "heuristic" },
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "sector", "value": "Bioscience" },
        { "type": "equals", "path": "customer", "value": "Fictional demo customer" },
        { "type": "not-contains", "path": "customer", "value": "Apex" },
        {
          "type": "equals",
          "path": "driverIds",
          "value": ["data-readiness", "human-review"]
        }
      ]
    },
    {
      "description": "The synthetic data banner is not used as the customer request",
      "vars": {
        "task": "forge",
        "brief": "SYNTHETIC DEMO DATA. Fictional company. Not real.\n\nThe warehouse team wants a clearer pick-list summary for one site."
      },
      "assert": [
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "heuristic" },
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "syntheticBanner", "value": true },
        { "type": "equals", "path": "customer", "value": "Fictional demo customer" },
        { "type": "contains", "path": "summary", "value": "warehouse team" },
        { "type": "not-contains", "path": "summary", "value": "SYNTHETIC DEMO DATA" },
        { "type": "equals", "path": "effortMin", "value": 8 },
        { "type": "equals", "path": "effortMax", "value": 15 }
      ]
    },
    {
      "description": "Effort bands follow the committed model, including duplicates and the full driver set",
      "vars": { "task": "effort" },
      "assert": [
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "smallMin", "value": 3 },
        { "type": "equals", "path": "smallMax", "value": 5 },
        { "type": "equals", "path": "mediumMin", "value": 6 },
        { "type": "equals", "path": "mediumMax", "value": 10 },
        { "type": "equals", "path": "largeMin", "value": 12 },
        { "type": "equals", "path": "largeMax", "value": 20 },
        { "type": "equals", "path": "duplicateMin", "value": 9 },
        { "type": "equals", "path": "duplicateMax", "value": 16 },
        { "type": "equals", "path": "duplicateCount", "value": 2 },
        { "type": "equals", "path": "fullMin", "value": 20 },
        { "type": "equals", "path": "fullMax", "value": 37 },
        { "type": "equals", "path": "fullCount", "value": 6 },
        { "type": "equals", "path": "error", "value": null }
      ]
    },
    {
      "description": "An unknown effort driver is rejected",
      "vars": { "task": "effort-unknown" },
      "assert": [
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "unknownRejected", "value": true },
        {
          "type": "contains",
          "path": "unknownMessage",
          "value": "Invalid option: expected one of \"integrations\""
        }
      ]
    },
    {
      "description": "With no provider key the run stays in demo mode and is not gated",
      "vars": { "task": "mode" },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "configuredMode", "value": "demo" },
        { "type": "equals", "path": "configuredProvider", "value": "openai" },
        { "type": "equals", "path": "gated", "value": false },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "error", "value": null }
      ]
    },
    {
      "description": "An OpenAI key blocks live generation and makes no model call",
      "vars": {
        "task": "forge",
        "sampleId": "04-fintech-kpi-narrative",
        "env": { "OPENAI_API_KEY": "eval-blocked-key" }
      },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": true },
        { "type": "equals", "path": "mode", "value": "live" },
        { "type": "equals", "path": "configuredMode", "value": "live" },
        { "type": "equals", "path": "configuredProvider", "value": "openai" },
        { "type": "equals", "path": "gated", "value": false },
        { "type": "equals", "path": "gate", "value": "open" },
        { "type": "equals", "path": "source", "value": null },
        { "type": "equals", "path": "customer", "value": null },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "error", "value": null }
      ]
    },
    {
      "description": "An Anthropic key blocks live generation and makes no model call",
      "vars": {
        "task": "forge",
        "sampleId": "01-logistics-visibility",
        "env": { "ANTHROPIC_API_KEY": "eval-blocked-key" }
      },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": true },
        { "type": "equals", "path": "configuredMode", "value": "live" },
        { "type": "equals", "path": "configuredProvider", "value": "anthropic" },
        { "type": "equals", "path": "source", "value": null },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 }
      ]
    },
    {
      "description": "Selecting Anthropic without its key stays on the recorded demo scope",
      "vars": {
        "task": "forge",
        "sampleId": "04-fintech-kpi-narrative",
        "env": {
          "LLM_PROVIDER": "anthropic",
          "OPENAI_API_KEY": "eval-blocked-key"
        }
      },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "fixture" },
        { "type": "equals", "path": "configuredMode", "value": "demo" },
        { "type": "equals", "path": "configuredProvider", "value": "anthropic" },
        { "type": "equals", "path": "gated", "value": false },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "customer", "value": "Sterling FinTech Ltd" },
        { "type": "equals", "path": "effortMin", "value": 12 },
        { "type": "equals", "path": "effortMax", "value": 23 }
      ]
    },
    {
      "description": "A configured access token rejects a live request that omits it",
      "vars": {
        "task": "forge",
        "sampleId": "04-fintech-kpi-narrative",
        "env": {
          "OPENAI_API_KEY": "eval-blocked-key",
