{
  "description": "Scope forge evals (demo mode, no model calls)",
  "providers": ["file://evals/provider.ts"],
  "prompts": ["{{task}}"],
  "sharing": false,
  "env": {
    "PROMPTFOO_DISABLE_TELEMETRY": "1",
    "PROMPTFOO_DISABLE_SHARING": "1"
  },
  "tests": [
    {
      "description": "Northwind Logistics brief returns the recorded scope in demo mode",
      "vars": { "task": "forge", "sampleId": "01-logistics-visibility" },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "mode", "value": "demo" },
        { "type": "equals", "path": "source", "value": "fixture" },
        { "type": "equals", "path": "configuredMode", "value": "demo" },
        { "type": "equals", "path": "gated", "value": false },
        { "type": "equals", "path": "gate", "value": "skipped" },
        { "type": "equals", "path": "calledModel", "value": false },
        { "type": "equals", "path": "networkRequests", "value": 0 },
        { "type": "equals", "path": "error", "value": null },
        { "type": "equals", "path": "syntheticBanner", "value": true },
        { "type": "equals", "path": "customer", "value": "Northwind Logistics Ltd" },
        { "type": "equals", "path": "sector", "value": "Logistics" },
        { "type": "equals", "path": "title", "value": "Consignment visibility, without the chase" },
        { "type": "contains", "path": "summary", "value": "read-only visibility pilot" },
        { "type": "contains", "path": "notice", "value": "curated scope fixture" },
        { "type": "equals", "path": "goalCount", "value": 3 },
        { "type": "equals", "path": "phaseCount", "value": 5 },
        {
          "type": "equals",
          "path": "phaseNames",
          "value": ["Discover", "Design", "Build", "Pilot", "Handover"]
        },
        {
          "type": "equals",
          "path": "groups",
          "value": ["Commercial", "Technical", "Operational", "Compliance"]
        },
        { "type": "gte", "path": "outOfScopeCount", "value": 1 },
        {
          "type": "equals",
          "path": "firstOut",
          "value": "Replacing transport or warehouse management systems."
        },
        { "type": "equals", "path": "effortSize", "value": "Medium" },
        { "type": "equals", "path": "effortMin", "value": 10 },
        { "type": "equals", "path": "effortMax", "value": 19 },
        {
          "type": "equals",
          "path": "driverIds",
          "value": ["integrations", "data-readiness", "human-review"]
        },
        { "type": "equals", "path": "matchesModel", "value": true },
        { "type": "equals", "path": "rangesValid", "value": true }
      ]
    },
    {
      "description": "Apex BioLabs brief returns the recorded scope in demo mode",
      "vars": { "task": "forge", "sampleId": "02-bioscience-qc" },
      "assert": [
        { "type": "equals", "path": "blockedLive", "value": false },
        { "type": "equals", "path": "mode", "value": "demo" },
