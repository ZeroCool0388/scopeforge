    },
    {
      "description": "Refreshing one section uses the alternate fixture and keeps an edited title",
      "vars": {
        "task": "section",
        "sampleId": "04-fintech-kpi-narrative",
        "section": "questions",
        "alternate": true,
        "editedTitle": "Edited title kept"
      },
      "assert": [
